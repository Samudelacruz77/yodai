[Unit]
Description=YodAI chatbot
After=network-online.target yodai-cdi-generate.service
Requires=yodai-cdi-generate.service

[Service]
Type=simple
WorkingDirectory=/etc/yodai
ExecStartPre=/usr/local/bin/podman-compose pull
ExecStart=/usr/local/bin/podman-compose up
ExecStop=/usr/local/bin/podman-compose down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
