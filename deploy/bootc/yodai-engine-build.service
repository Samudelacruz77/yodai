[Unit]
Description=Build YodAI TensorRT-LLM engine (one-time)
After=network-online.target yodai-cdi-generate.service
Requires=yodai-cdi-generate.service
Before=yodai.service
ConditionPathExists=!/var/lib/yodai/engine-built

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm \
    --device nvidia.com/gpu=all \
    --security-opt label=disable \
    --secret huggingface_token,type=env,target=HUGGINGFACE_TOKEN \
    -v yodai_model-data:/data/models \
    -v /etc/yodai/build-engine.sh:/data/build-engine.sh:ro,Z \
    dustynv/tensorrt_llm:0.12-r36.4.0 \
    bash /data/build-engine.sh
ExecStartPost=/usr/bin/mkdir -p /var/lib/yodai
ExecStartPost=/usr/bin/touch /var/lib/yodai/engine-built
RemainAfterExit=yes
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
