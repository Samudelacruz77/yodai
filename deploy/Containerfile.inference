FROM dustynv/tensorrt_llm:0.12-r36.4.0

# Patch pynvml bug in TensorRT-LLM 0.12 (NameError on Jetson iGPU)
RUN sed -i 's/except pynvml\.NVMLError:/except Exception:/' \
    /usr/local/lib/python3.10/dist-packages/tensorrt_llm/auto_parallel/cluster_info.py

COPY start-inference.sh /opt/start-inference.sh
RUN chmod +x /opt/start-inference.sh

COPY engine/ /data/models/engine/
COPY tokenizer/ /data/models/tokenizer/

ENV ENGINE_DIR=/data/models/engine
ENV TOKENIZER_DIR=/data/models/tokenizer
ENV HOST=0.0.0.0
ENV PORT=8000

EXPOSE 8000

CMD ["/opt/start-inference.sh"]
